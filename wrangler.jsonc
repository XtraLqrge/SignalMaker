{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signalmaker",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "signal.hwysignmaker.com",
      "custom_domain": true
    }
  ]
}
